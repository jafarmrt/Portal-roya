# ---- Required ----
# PostgreSQL connection. With docker compose this is set automatically from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/portal
# Database password used by docker-compose.yml.
POSTGRES_PASSWORD=CHANGE_ME
# Random string, at least 32 characters, used to sign login sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---- Server ----
PORT=3000
# Host port published by docker compose; pick a free one if 3000 is taken.
PORTAL_PORT=3000
# Host address the port is published on. Use 127.0.0.1 when nginx on the same server is in front.
PORTAL_BIND=0.0.0.0
# Prefix for container and volume names, keeps them apart from other apps on the server.
COMPOSE_PROJECT_NAME=roya-portal
# Address colleagues use to open the portal; used in e-mail links.
APP_URL=http://portal.roya.local
# Days a login stays valid.
SESSION_DAYS=7
# true only when the portal is served over HTTPS.
COOKIE_SECURE=false
# true when the portal runs behind nginx or another reverse proxy.
TRUST_PROXY=false
# Optional: required code for the first-time setup page, so nobody else on the network can claim the admin account first.
SETUP_TOKEN=

# ---- Files ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Internal e-mail (optional) ----
# Leave SMTP_HOST empty to turn e-mail off. Urgent news and circulars are e-mailed when it is set.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portal@roya.local

# ---- Tests only ----
TEST_DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_test
