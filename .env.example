# ---- Required ----
# PostgreSQL connection. With docker compose this is set automatically from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/portal
# Database password used by docker-compose.yml.
POSTGRES_PASSWORD=CHANGE_ME
# Random string, at least 32 characters, used to sign login sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---- Server ----
PORT=3000
# Address the server listens on. Use 127.0.0.1 when running without Docker behind nginx.
HOST=0.0.0.0
# Host port published by docker compose; pick a free one if 3000 is taken.
PORTAL_PORT=3000
# Host address the port is published on. Use 127.0.0.1 when nginx on the same server is in front.
PORTAL_BIND=0.0.0.0
# Prefix for container and volume names, keeps them apart from other apps on the server.
COMPOSE_PROJECT_NAME=roya-portal
# Address colleagues use to open the portal; used in e-mail links.
APP_URL=http://portal.roya.local
# Days a login stays valid.
SESSION_DAYS=7
# true only when the portal is served over HTTPS.
COOKIE_SECURE=false
# true when the portal runs behind nginx or another reverse proxy.
TRUST_PROXY=false
# Optional: required code for the first-time setup page, so nobody else on the network can claim the admin account first.
SETUP_TOKEN=

# ---- Files ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Internal e-mail (optional) ----
# Leave SMTP_HOST empty to turn e-mail off. Urgent news and circulars are e-mailed when it is set.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portal@roya.local

# ---- Tests only ----
TEST_DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_test

# ---- Active Directory sign-in (optional) ----
# Leave LDAP_URL empty to use only portal accounts. When set, staff sign in with their Windows
# username and password; local portal accounts (e.g. the first admin) keep working.
# See deploy/AD-LOGIN.md. Prefer ldaps:// (port 636); ldap:// sends passwords in clear text.
LDAP_URL=
# Where users are searched, e.g. DC=roya,DC=local or OU=Staff,DC=roya,DC=local
LDAP_BASE_DN=
# Read-only service account used to look users up (recommended), e.g. CN=svc-portal,OU=Service Accounts,DC=roya,DC=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Without a service account: the domain users sign in to (username@LDAP_DOMAIN), e.g. roya.local
LDAP_DOMAIN=
# Optional: only members of this group may sign in (full DN; nested groups count).
LDAP_ALLOWED_GROUP=
# Optional: members of this group become portal managers, everyone else becomes an employee.
# Leave empty to manage roles in the portal instead.
LDAP_ADMIN_GROUP=
# Optional: CA certificate (PEM) of the domain, for ldaps:// with an internal certificate authority.
LDAP_CA_FILE=
# Upgrade ldap:// to TLS with StartTLS.
LDAP_STARTTLS=false
# false skips certificate checks (only for a first test).
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Search filter; {{username}} is replaced with the escaped login name.
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={{username}}))
LDAP_TIMEOUT_MS=8000
